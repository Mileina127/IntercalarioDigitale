<UserControl x:Class="IntercalarioDigitale.Desktop.PdfPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             PreviewMouseDown="Pane_PreviewMouseDown"
             PreviewKeyDown="Pane_PreviewKeyDown">
    <Border Background="{StaticResource WindowBg}"
            BorderBrush="{StaticResource Stroke}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,6">
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Light"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextMain}"/>
                <TextBlock x:Name="SubText" FontSize="12" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"
                           MaxWidth="360"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Colonna dei documenti (allegati e annessi): non delle pagine del PDF. -->
                <Grid x:Name="RailBox" Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox x:Name="Rail" Grid.Row="0"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="Rail_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="46" Height="30" Margin="{Binding Indent}" ToolTip="{Binding Title}">
                                    <TextBlock Text="{Binding Label}" FontSize="{Binding LabelSize}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Ellipse Width="6" Height="6" Fill="#E53935"
                                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0"
                                             Visibility="{Binding InkVisibility}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button x:Name="AddButton" Grid.Row="1" Content="+" FontSize="16" Padding="0"
                            Width="46" Height="30" Margin="0,2,0,0"
                            ToolTip="Aggiungi un documento" Click="AddButton_Click"/>
                </Grid>

                <Border x:Name="Host" Grid.Column="1" ClipToBounds="True"
                        SizeChanged="Host_SizeChanged">
                    <Viewbox Stretch="Uniform">
                        <Border BorderBrush="{StaticResource StrokeStrong}" BorderThickness="0.8" Background="White">
                            <Grid x:Name="PageGrid" Width="595" Height="842">
                                <Image x:Name="PageImage" Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <InkCanvas x:Name="Ink" Background="Transparent"
                                           EditingMode="None" IsHitTestVisible="False"
                                           StrokeCollected="Ink_StrokeCollected"/>
                            </Grid>
                        </Border>
                    </Viewbox>
                </Border>
            </Grid>

            <!-- Navigatore delle pagine del PDF aperto. -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button x:Name="PrevButton" Content="◀" FontSize="11" Width="36" Height="28"
                        ToolTip="Pagina precedente (Pag ↑)" Click="PrevButton_Click"/>
                <TextBlock x:Name="PagerText" MinWidth="170" Margin="10,0" TextAlignment="Center"
                           VerticalAlignment="Center" Foreground="{StaticResource TextMain}"/>
                <Button x:Name="NextButton" Content="▶" FontSize="11" Width="36" Height="28"
                        ToolTip="Pagina successiva (Pag ↓)" Click="NextButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
