<Window x:Class="IntercalarioDigitale.Desktop.ViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IntercalarioDigitale.Desktop"
        Title="Contropagina e allegato"
        Width="1300" Height="840" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Intestazione -->
        <Border Grid.Row="0" Padding="18,10" Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button x:Name="StructButton" DockPanel.Dock="Right" Content="Struttura intercalario"
                        Click="StructButton_Click"/>
                <TextBlock x:Name="HolderText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                           Foreground="{StaticResource TextMuted}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="IdText" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock x:Name="NameText" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Border Background="{StaticResource AccentSoft}" CornerRadius="10" Padding="10,2"
                            Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusBadge" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Accent}"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Barra della penna -->
        <Border x:Name="PenBar" Grid.Row="1" Visibility="Collapsed" Margin="16,12,16,0" Padding="12,6"
                CornerRadius="8" Background="{StaticResource CardBg}"
                BorderBrush="{StaticResource Stroke}" BorderThickness="1">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Disegna con mouse, penna o dito" VerticalAlignment="Center" Margin="0,0,16,0"
                           Foreground="{StaticResource TextMuted}"/>

                <RadioButton GroupName="penColor" Style="{StaticResource {x:Type ToggleButton}}" Tag="#E53935"
                             IsChecked="True" Padding="8,6" Margin="0,0,6,0" Click="PenColor_Click" ToolTip="Rosso">
                    <Rectangle Width="16" Height="16" RadiusX="8" RadiusY="8" Fill="#E53935"/>
                </RadioButton>
                <RadioButton GroupName="penColor" Style="{StaticResource {x:Type ToggleButton}}" Tag="#1E88E5"
                             Padding="8,6" Margin="0,0,6,0" Click="PenColor_Click" ToolTip="Blu">
                    <Rectangle Width="16" Height="16" RadiusX="8" RadiusY="8" Fill="#1E88E5"/>
                </RadioButton>
                <RadioButton GroupName="penColor" Style="{StaticResource {x:Type ToggleButton}}" Tag="#1D2128"
                             Padding="8,6" Margin="0,0,18,0" Click="PenColor_Click" ToolTip="Inchiostro">
                    <Rectangle Width="16" Height="16" RadiusX="8" RadiusY="8" Fill="#1D2128"/>
                </RadioButton>

                <RadioButton GroupName="penWidth" Style="{StaticResource {x:Type ToggleButton}}" Tag="2"
                             Padding="10,6" Margin="0,0,6,0" Click="PenWidth_Click" ToolTip="Sottile">
                    <Rectangle Width="18" Height="2" Fill="{StaticResource TextMain}"/>
                </RadioButton>
                <RadioButton GroupName="penWidth" Style="{StaticResource {x:Type ToggleButton}}" Tag="3"
                             IsChecked="True" Padding="10,6" Margin="0,0,6,0" Click="PenWidth_Click" ToolTip="Medio">
                    <Rectangle Width="18" Height="3" Fill="{StaticResource TextMain}"/>
                </RadioButton>
                <RadioButton GroupName="penWidth" Style="{StaticResource {x:Type ToggleButton}}" Tag="5"
                             Padding="10,6" Margin="0,0,18,0" Click="PenWidth_Click" ToolTip="Spesso">
                    <Rectangle Width="18" Height="5" Fill="{StaticResource TextMain}"/>
                </RadioButton>

                <Button Content="Annulla" Margin="0,0,6,0" Click="UndoButton_Click"
                        ToolTip="Toglie l'ultimo tratto dell'ultima pagina in cui hai scritto"/>
                <Button Content="Cancella pagina" Click="ClearButton_Click"
                        ToolTip="Cancella i tratti dell'ultima pagina in cui hai scritto"/>
            </WrapPanel>
        </Border>

        <!-- Pagine e pannello laterale -->
        <Grid Grid.Row="2" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <local:PdfPane x:Name="CoverPane" Grid.Column="0" Margin="0,0,6,0"/>
                <local:PdfPane x:Name="AttachmentPane" Grid.Column="1" Margin="6,0,0,0"/>
            </Grid>

            <Border x:Name="SidePanel" Grid.Column="1" Width="350" Margin="12,0,0,0" Visibility="Collapsed"
                    Background="{StaticResource WindowBg}" BorderBrush="{StaticResource Stroke}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <!-- Assistente IA -->
                    <Grid x:Name="AiPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Assistente IA per Allegatario" FontWeight="SemiBold" FontSize="14"
                                   Margin="16,12,16,0"/>
                        <TextBlock x:Name="ScopeText" Grid.Row="1" Margin="16,6,16,0" FontSize="12"
                                   Foreground="{StaticResource TextMuted}"/>
                        <ScrollViewer x:Name="ChatScroll" Grid.Row="2" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ChatStack" Margin="12,0"/>
                        </ScrollViewer>
                        <WrapPanel x:Name="SuggestionPanel" Grid.Row="3" Margin="12,6,12,0"/>
                        <Grid Grid.Row="4" Margin="12,8,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="AskBox" Grid.Column="0" MinHeight="40" MaxHeight="100"
                                     AcceptsReturn="False" TextWrapping="Wrap" Padding="6"
                                     VerticalContentAlignment="Center" KeyDown="AskBox_KeyDown"/>
                            <Button Grid.Column="1" Content="Invia" Margin="8,0,0,0" Click="SendButton_Click"
                                    Style="{StaticResource PrimaryButton}"/>
                        </Grid>
                        <TextBlock Grid.Row="5" Margin="16,8,16,12" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMuted}"
                                   Text="Le risposte sono simulate e lette dai dati di questa pratica: nessun modello è collegato."/>
                    </Grid>

                    <!-- Validazioni -->
                    <Grid x:Name="ValPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="VALIDAZIONI" FontWeight="SemiBold" FontSize="14"
                                   Margin="16,12,16,0"/>
                        <TextBlock x:Name="ValSummary" Grid.Row="1" Margin="16,4,16,0" FontSize="12"
                                   Foreground="{StaticResource TextMuted}"/>
                        <WrapPanel x:Name="StampPanel" Grid.Row="2" Margin="12,10,12,4"/>
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                            <StackPanel x:Name="ValList" Margin="12,0,12,12"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Azioni -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,8">
            <ToggleButton x:Name="AnnotationToggle" Content="ANNOTAZIONI" Margin="0,0,10,0"
                          Click="AnnotationToggle_Click"/>
            <ToggleButton x:Name="AiToggle" Content="ANALISI IA" Margin="0,0,10,0" Click="AiToggle_Click"/>
            <ToggleButton x:Name="ValToggle" Content="VALIDAZIONE" Margin="0,0,10,0" Click="ValToggle_Click"/>
            <Button x:Name="ScopeButton" Content="•••" Padding="12,8" ToolTip="Ambito dell'analisi IA"
                    Click="ScopeButton_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="18,0,0,0" FontSize="12"
                       Foreground="{StaticResource TextMuted}"/>
        </StackPanel>
    </Grid>
</Window>
